{
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nitro build",
    "dev": "nitro dev --bun --port 3003 --https --ssl-cert .cert/cert.pem --ssl-key .cert/key.pem",
    "dev:http": "nitro dev --bun --port 3003",
    "dev:1": "PORT=3003 nitro dev --bun --https --ssl-cert .cert/cert.pem --ssl-key .cert/key.pem",
    "dev:2": "PORT=3004 nitro dev --bun --https --ssl-cert .cert/cert.pem --ssl-key .cert/key.pem",
    "dev:3": "PORT=3005 nitro dev --bun --https --ssl-cert .cert/cert.pem --ssl-key .cert/key.pem",
    "dev:4": "PORT=3006 nitro dev --bun --https --ssl-cert .cert/cert.pem --ssl-key .cert/key.pem",
    "dev:5": "PORT=3007 nitro dev --bun --https --ssl-cert .cert/cert.pem --ssl-key .cert/key.pem",
    "dev:6": "PORT=3008 nitro dev --bun --https --ssl-cert .cert/cert.pem --ssl-key .cert/key.pem",
    "dev:http:1": "PORT=3003 nitro dev --bun",
    "dev:http:2": "PORT=3004 nitro dev --bun",
    "dev:http:3": "PORT=3005 nitro dev --bun",
    "dev:http:4": "PORT=3006 nitro dev --bun",
    "dev:http:5": "PORT=3007 nitro dev --bun",
    "dev:http:6": "PORT=3008 nitro dev --bun",
    "start": "concurrently --names \"I1,I2,I3,I4,I5,I6,LB\" -c \"cyan,magenta,yellow,green,blue,red,white\" \"bun run dev:http:1\" \"bun run dev:http:2\" \"bun run dev:http:3\" \"bun run dev:http:4\" \"bun run dev:http:5\" \"bun run dev:http:6\" \"sleep 5 && (bun run lb:start || bun run lb:start:docker)\"",
    "stop": "(bun run lb:stop || bun run lb:stop:docker) && pkill -f 'nitro dev'",
    "lb:start": "nginx -c $(pwd)/nginx-dev-lb.conf -p $(pwd)",
    "lb:stop": "nginx -s stop -c $(pwd)/nginx-dev-lb.conf -p $(pwd)",
    "lb:reload": "nginx -s reload -c $(pwd)/nginx-dev-lb.conf -p $(pwd)",
    "lb:start:docker": "docker run -d --name webbites-lb -p 8080:8080 -v $(pwd)/nginx-dev-lb.conf:/etc/nginx/conf.d/default.conf --network host nginx:alpine",
    "lb:stop:docker": "docker stop webbites-lb && docker rm webbites-lb",
    "docker:build": "sh docker-build.sh",
    "docker:start": "bun run docker:build && docker run -p 3003:3003 --env-file .env webbites-backend",
    "prepare": "nitro prepare",
    "preview": "bun run ./.output/server/index.mjs",
    "create-api-key": "bun run scripts/create-api-key.ts",
    "backfill-app-listings": "bun run scripts/backfill-app-listings.ts",
    "test:appListing": "tsx server/utils/appListing.test.ts",
