# WebBites self-hosted: settings for docker-compose.yml.
# `./install.sh` writes this file for you with fresh secrets. Edit it by hand only to change
# something; keep it out of version control and back it up (it holds the keys to your data).

# ---- where it runs -------------------------------------------------------------------------
# The address people type, without a trailing slash. HTTPS is strongly recommended.
PUBLIC_URL=http://localhost
# What Caddy listens for. A real domain gets a Let's Encrypt certificate automatically.
# "http://localhost" serves plain http (fine for trying it out on one machine).
SITE_ADDRESS=http://localhost
HTTP_PORT=80
HTTPS_PORT=443

# Which release to run: a version such as 1.0.0, or "latest".
WEBBITES_VERSION=latest

# Optional components, comma separated: screenshots, rustfs
#   screenshots  the headless-browser service that takes bookmark screenshots (about 1 GB of RAM)
#   rustfs       an S3-compatible object store for files, instead of keeping them in MongoDB
COMPOSE_PROFILES=screenshots

# The first person to sign up becomes the administrator. Set this to make it only that address.
INITIAL_ADMIN_EMAIL=

# ---- secrets (generated by install.sh, never reuse them elsewhere) ----------------------------
MONGO_PASSWORD=
PARSE_APP_ID=
PARSE_JS_KEY=
PARSE_MASTER_KEY=
CUSTOM_API_KEY=
AUDIO_TOKEN_SECRET=
SHARE_LINK_SECRET=
BACKUP_ENCRYPTION_KEY=
SETTINGS_ENCRYPTION_KEY=
MEILI_MASTER_KEY=
SCREENSHOT_API_KEY=
# Set by install.sh when the screenshots profile is on.
SCREENSHOT_SERVICE_URL=
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=

# ---- email (needed for password reset and invitations) -----------------------------------------
# Leave MAIL_PROVIDER empty to run without email: invite links are shown in the app to copy, and
# an administrator can't reset passwords by mail.
MAIL_PROVIDER=
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# ---- AI features (summaries, tags, audio, semantic search) -------------------------------------
# Any OpenAI-compatible endpoint: OpenAI, LiteLLM, Ollama, vLLM, OpenRouter...
AI_API_BASE_URL=
AI_API_KEY=
AI_TEXT_MODEL=
AI_MULTIMODAL_MODEL=
EMBEDDING_MODEL=

# ---- file storage ------------------------------------------------------------------------------
# FILES_DRIVER=gridfs (default, files live in MongoDB) or s3. With the rustfs profile these are
# filled in for you by install.sh; for AWS S3, Backblaze, Cloudflare R2, MinIO... set them yourself.
FILES_DRIVER=
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# ---- optional integrations ---------------------------------------------------------------------
APP_NAME=WebBites
SUPPORT_EMAIL=
SENTRY_DSN=
TMDB_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
